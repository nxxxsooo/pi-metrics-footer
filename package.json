{
  "name": "pi-metrics-footer",
  "version": "0.1.0",
  "description": "Live model speed (tokens/s), token/cost/context stats, and configurable model labels in the pi TUI footer",
  "keywords": [
    "pi",
    "pi-package",
    "extension",
    "footer",
    "metrics",
    "tokens",
    "tps",
    "tokens-per-second"
  ],
  "license": "MIT",
  "type": "module",
  "pi": {
    "extensions": ["./extensions"]
  },
  "files": [
    "extensions"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run typecheck"
  },
  "devDependencies": {
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*",
    "@types/node": "^22",
    "typescript": "^5"
  }
}
